# Copier ce fichier en .env.local (jamais commité) et remplir avec les valeurs du projet Supabase.

# URL publique du site (sert aux liens des emails et aux redirections OAuth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : côté serveur uniquement. Ne JAMAIS la préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Sel pour anonymiser les adresses IP avant la limitation de débit (32+ caractères aléatoires).
# Générer avec : openssl rand -base64 48
IP_HASH_SECRET=change-me-with-a-long-random-string
