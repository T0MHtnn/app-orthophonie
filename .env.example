# Copier ce fichier en .env.local (jamais commité) et remplir avec les valeurs du projet Supabase.

# URL publique du site (sert aux liens des emails et aux redirections OAuth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Envoi d'emails depuis l'app (Brevo > Paramètres > SMTP et API > Clés API). Côté serveur uniquement.
BREVO_API_KEY=xkeysib-xxx
# Expéditeur vérifié dans Brevo (Paramètres > Expéditeurs)
EMAIL_SENDER_EMAIL=ton-adresse@gmail.com
EMAIL_SENDER_NAME=Cabinet d'orthophonie

# Tâche planifiée du matin (propositions de créneaux libérés). Chaîne aléatoire d'au moins 32 caractères,
# à mettre aussi (empreinte SHA-256) dans private.app_secrets : voir CLAUDE.md.
CRON_SECRET=
